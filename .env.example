# API settings. Copy to the host's env file; never commit real values.
APP_ENV=production
API_HOST=127.0.0.1
API_PORT=
DB_PATH=./callready.db
PACKS_DIR=../data/packs
ALLOWED_ORIGINS=https://<your-vercel-app>.vercel.app

# OpenAI-compatible LLM gateway
LLM_BASE_URL=http://127.0.0.1:<gateway-port>/v1
LLM_API_KEY=
MODEL_STRONG=
MODEL_FAST=
MODEL_FALLBACKS=

# cost and abuse controls
LLM_DAILY_CAP=400
LLM_CLIENT_HOURLY_CAP=30
SESSION_TTL_DAYS=7
